# true: 브라우저 localStorage 기반 mock API 클라이언트 사용
# false(기본값): 아래 VITE_API_BASE_URL의 실제 백엔드 호출
VITE_USE_MOCK_API=false

# 실제 백엔드 서버 주소. docs/api-spec.md는 "/api/v1"을 명시하지만
# 현재 backend/app/main.py는 prefix 없이 라우터를 등록해 실제 경로는 prefix 없는 /auth/* 등이다.
# 백엔드가 /api/v1 prefix를 붙이도록 바뀌면 이 값도 함께 바꿔야 한다.
#
# 배포된 백엔드(실제 AtCoder_100 100문제 데이터 포함)를 기본값으로 사용한다.
# CORS 허용 목록(backend/app/main.py)에 이 값과 http://localhost:3000만 등록돼 있으므로,
# 로컬 백엔드로 바꿔 쓰려면 이 값과 프론트 dev 서버 포트(3000)를 함께 맞춰야 한다.
VITE_API_BASE_URL=https://api.codeback.madcamp-kaist.org
